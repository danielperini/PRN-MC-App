{
  "name": "ExportQueue",
  "type": "object",
  "properties": {
    "relatorio_id": {
      "type": "string",
      "description": "ID do RelatorioExecucaoObjeto"
    },
    "destinatario": {
      "type": "string",
      "description": "Email do destinat\u00e1rio"
    },
    "folder_id": {
      "type": "string",
      "description": "ID da pasta no Google Drive"
    },
    "folder_link": {
      "type": "string",
      "description": "Link da pasta no Drive"
    },
    "nome_relatorio": {
      "type": "string",
      "description": "Nome base dos arquivos"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "processando",
        "concluido",
        "erro"
      ],
      "default": "pendente"
    },
    "partes_total": {
      "type": "number",
      "default": 0,
      "description": "Total de partes a processar (3 + lotes fotos)"
    },
    "partes_concluidas": {
      "type": "number",
      "default": 0
    },
    "parte_atual": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da parte em processamento"
    },
    "resultados": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Lista de { nome, link, arquivo } de cada parte gerada"
    },
    "erros": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Erros por parte"
    },
    "total_fotos": {
      "type": "number",
      "default": 0
    },
    "total_lotes_fotos": {
      "type": "number",
      "default": 0
    },
    "email_enviado": {
      "type": "boolean",
      "default": false
    },
    "iniciado_em": {
      "type": "string",
      "format": "date-time"
    },
    "concluido_em": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "relatorio_id",
    "destinatario"
  ]
}