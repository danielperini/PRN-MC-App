{
  "name": "TermoCompromisso",
  "type": "object",
  "properties": {
    "numero_tc": {
      "type": "string",
      "description": "Numeracao unica no padrao TC-MC-AAAA-NNN (ex: TC-MC-2026-001)"
    },
    "numero_termo": {
      "type": "string",
      "description": "Campo legado de compatibilidade"
    },
    "projeto": {
      "type": "string",
      "description": "Chave do projeto selecionado"
    },
    "tipo_termo": {
      "type": "string",
      "enum": [
        "monitoria_mediacao",
        "oficina",
        "palestra",
        "acao_cultural",
        "apresentacao_artistica",
        "projeto_videografico",
        "consultoria",
        "producao_apoio",
        "expografia",
        "outro"
      ],
      "description": "Tipo do termo de compromisso"
    },
    "funcao_projeto": {
      "type": "string",
      "description": "Funcao exercida no projeto (ex: Educadora, Designer)"
    },
    "centro_custo": {
      "type": "string",
      "enum": [
        "MIS",
        "MHAB",
        "MUMO",
        "Atuacao Geral",
        "Noturno nos Museus Centro",
        "Noturno nos Museus Pampulha"
      ],
      "description": "Centro de custo / Projeto vinculado ao termo"
    },
    "produto_entrega": {
      "type": "string",
      "description": "Produto ou entrega gerado neste termo"
    },
    "atividade_relacionada_id": {
      "type": "string",
      "description": "ID da atividade relacionada (FK Activity)"
    },
    "atividade_relacionada_manual": {
      "type": "string",
      "description": "Descricao manual da atividade quando nao cadastrada"
    },
    "contratado_nome": {
      "type": "string"
    },
    "contratado_cpf_cnpj": {
      "type": "string"
    },
    "contratado_cpf": {
      "type": "string"
    },
    "contratado_cnpj": {
      "type": "string"
    },
    "contratado_representante": {
      "type": "string"
    },
    "contratado_cpf_representante": {
      "type": "string"
    },
    "contratado_endereco": {
      "type": "string"
    },
    "contratado_telefone": {
      "type": "string"
    },
    "contratado_email": {
      "type": "string"
    },
    "contratado_banco": {
      "type": "string"
    },
    "contratado_agencia": {
      "type": "string"
    },
    "contratado_conta": {
      "type": "string"
    },
    "tipo_conta": {
      "type": "string",
      "enum": [
        "Corrente",
        "Poupanca"
      ]
    },
    "pix_key": {
      "type": "string"
    },
    "objeto": {
      "type": "string"
    },
    "escopo": {
      "type": "string"
    },
    "museu": {
      "type": "string"
    },
    "local_execucao": {
      "type": "string"
    },
    "periodo_execucao": {
      "type": "string"
    },
    "data_inicio": {
      "type": "string",
      "format": "date"
    },
    "data_fim": {
      "type": "string",
      "format": "date"
    },
    "data_assinatura": {
      "type": "string",
      "format": "date"
    },
    "cidade_assinatura": {
      "type": "string"
    },
    "valor_total": {
      "type": "number"
    },
    "detalhamento_valores": {
      "type": "string"
    },
    "forma_pagamento": {
      "type": "string"
    },
    "numero_parcelas": {
      "type": "number"
    },
    "valor_parcela": {
      "type": "number"
    },
    "datas_vencimento": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parcelas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "numero": {
            "type": "number"
          },
          "valor": {
            "type": "number"
          },
          "data_vencimento": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "descricao_nf_editavel": {
      "type": "string"
    },
    "rubrica_vinculada": {
      "type": "string"
    },
    "testemunha1_nome": {
      "type": "string"
    },
    "testemunha1_cpf": {
      "type": "string"
    },
    "testemunha2_nome": {
      "type": "string"
    },
    "testemunha2_cpf": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "gerado",
        "assinado",
        "finalizado",
        "cancelado"
      ],
      "default": "rascunho"
    },
    "pdf_url": {
      "type": "string"
    },
    "drive_backup_url": {
      "type": "string"
    },
    "drive_backup_path": {
      "type": "string"
    },
    "drive_backup_status": {
      "type": "string",
      "enum": [
        "pendente",
        "em_processamento",
        "concluido",
        "erro"
      ]
    },
    "drive_backup_at": {
      "type": "string",
      "format": "date-time"
    },
    "drive_file_id": {
      "type": "string"
    },
    "drive_file_name": {
      "type": "string"
    },
    "gerado_por_email": {
      "type": "string"
    },
    "gerado_por_nome": {
      "type": "string"
    },
    "origem_arquivo_url": {
      "type": "string"
    },
    "dados_extraidos_ia": {
      "type": "object"
    },
    "divergencias_ia": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "nota_fiscal_url": {
      "type": "string"
    },
    "termo_assinado_url": {
      "type": "string"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "contratado_nome",
    "objeto",
    "valor_total"
  ]
}