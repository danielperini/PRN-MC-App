{
  "name": "PontoEntorno",
  "type": "object",
  "properties": {
    "museu_sigla": {
      "type": "string",
      "enum": [
        "MHAB",
        "MIS",
        "MUMO",
        "Viaduto das Artes"
      ],
      "description": "Museu de refer\u00eancia"
    },
    "nome": {
      "type": "string",
      "description": "Nome da institui\u00e7\u00e3o/local"
    },
    "categoria": {
      "type": "string",
      "description": "Categoria (escola, centro cultural, biblioteca, etc)"
    },
    "bairro": {
      "type": "string",
      "description": "Bairro de localiza\u00e7\u00e3o"
    },
    "endereco": {
      "type": "string",
      "description": "Endere\u00e7o completo"
    },
    "coordenadas_lat": {
      "type": "number",
      "description": "Latitude"
    },
    "coordenadas_lon": {
      "type": "number",
      "description": "Longitude"
    },
    "distancia_estimada": {
      "type": "number",
      "description": "Dist\u00e2ncia em km do museu"
    },
    "publicos_alvo": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "P\u00fablicos potenciais"
    },
    "aderencia_tematica": {
      "type": "number",
      "default": 0,
      "description": "Score 0-100 de alinhamento tem\u00e1tico"
    },
    "prioridade": {
      "type": "string",
      "enum": [
        "Alta",
        "M\u00e9dia",
        "Baixa"
      ],
      "default": "M\u00e9dia",
      "description": "Prioridade de mobiliza\u00e7\u00e3o"
    },
    "oportunidades_sugeridas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tipos de oportunidades (oficinas, visitas, pesquisa, etc)"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o ponto est\u00e1 ativo no mapa"
    },
    "data_analise": {
      "type": "string",
      "format": "date-time",
      "description": "Data da \u00faltima an\u00e1lise por IA"
    }
  },
  "required": [
    "museu_sigla",
    "nome",
    "categoria",
    "coordenadas_lat",
    "coordenadas_lon"
  ]
}