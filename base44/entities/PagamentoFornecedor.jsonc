{
  "name": "PagamentoFornecedor",
  "type": "object",
  "properties": {
    "fornecedor_id": {
      "type": "string",
      "description": "ID do fornecedor (FK \u2192 Fornecedor)"
    },
    "termo_id": {
      "type": "string",
      "description": "ID do termo de compromisso (FK \u2192 TermoCompromisso, opcional)"
    },
    "tipo_pagamento": {
      "type": "string",
      "enum": [
        "transferencia_bancaria",
        "pix",
        "deposito"
      ],
      "description": "Tipo de pagamento realizado"
    },
    "valor_pago": {
      "type": "number",
      "description": "Valor pago"
    },
    "data_pagamento": {
      "type": "string",
      "format": "date",
      "description": "Data do pagamento"
    },
    "data_confirmacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora de confirma\u00e7\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "pago",
        "comprovado"
      ],
      "default": "pendente",
      "description": "Status do pagamento"
    },
    "comprovante_url": {
      "type": "string",
      "description": "URL do comprovante de pagamento (recibo, transfer\u00eancia, etc)"
    },
    "comprovante_nome": {
      "type": "string",
      "description": "Nome do arquivo do comprovante"
    },
    "descricao_pagamento": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o/notas sobre o pagamento"
    },
    "confirmado_por_email": {
      "type": "string",
      "description": "Email de quem confirmou o pagamento"
    },
    "confirmado_por_nome": {
      "type": "string",
      "description": "Nome de quem confirmou"
    },
    "referencia_bancaria": {
      "type": "string",
      "description": "N\u00famero de refer\u00eancia da transfer\u00eancia/TED/PIX"
    }
  },
  "required": [
    "fornecedor_id",
    "valor_pago",
    "tipo_pagamento"
  ]
}