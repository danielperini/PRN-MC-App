{
  "name": "PurchaseNotificationConfig",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email do destinat\u00e1rio"
    },
    "nome": {
      "type": "string",
      "description": "Nome do destinat\u00e1rio para identifica\u00e7\u00e3o"
    },
    "perfil": {
      "type": "string",
      "enum": [
        "coordenador",
        "administracao",
        "financeiro",
        "outro"
      ],
      "default": "coordenador",
      "description": "Perfil do destinat\u00e1rio"
    },
    "tipo_notificacao": {
      "type": "string",
      "enum": [
        "imediato",
        "pacote_diario"
      ],
      "default": "pacote_diario",
      "description": "imediato = recebe email a cada solicita\u00e7\u00e3o; pacote_diario = recebe resumo di\u00e1rio \u00e0s 6h com todas as solicita\u00e7\u00f5es das \u00faltimas 24h"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o destinat\u00e1rio est\u00e1 ativo"
    },
    "recebe_aprovacoes": {
      "type": "boolean",
      "default": true,
      "description": "Recebe notifica\u00e7\u00f5es de aprova\u00e7\u00e3o"
    },
    "recebe_novas_solicitacoes": {
      "type": "boolean",
      "default": true,
      "description": "Recebe notifica\u00e7\u00f5es de novas solicita\u00e7\u00f5es"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es sobre o destinat\u00e1rio"
    }
  },
  "required": [
    "email",
    "perfil"
  ]
}