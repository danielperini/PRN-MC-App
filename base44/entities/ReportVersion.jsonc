{
  "name": "ReportVersion",
  "type": "object",
  "properties": {
    "report_id": {
      "type": "string",
      "description": "ID do relat\u00f3rio pai"
    },
    "version_number": {
      "type": "number",
      "description": "N\u00famero da vers\u00e3o"
    },
    "data_snapshot": {
      "type": "object",
      "description": "Snapshot completo dos dados do relat\u00f3rio nesta vers\u00e3o"
    },
    "changed_by_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio que fez a altera\u00e7\u00e3o"
    },
    "changed_by_name": {
      "type": "string",
      "description": "Nome do usu\u00e1rio que fez a altera\u00e7\u00e3o"
    },
    "change_description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da altera\u00e7\u00e3o (ex: 'Auto-save', 'Edi\u00e7\u00e3o manual')"
    },
    "last_update_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp da \u00faltima atualiza\u00e7\u00e3o nesta vers\u00e3o"
    }
  },
  "required": [
    "report_id",
    "version_number",
    "data_snapshot",
    "changed_by_email"
  ]
}