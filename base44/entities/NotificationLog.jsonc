{
  "name": "NotificationLog",
  "type": "object",
  "properties": {
    "notification_type": {
      "type": "string",
      "description": "Tipo da notifica\u00e7\u00e3o (PURCHASE_DIGEST, PURCHASE_APPROVED, etc.)"
    },
    "channel": {
      "type": "string",
      "enum": [
        "EMAIL",
        "WHATSAPP",
        "TELEGRAM"
      ],
      "description": "Canal de envio"
    },
    "recipients": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de destinat\u00e1rios"
    },
    "subject": {
      "type": "string",
      "description": "Assunto do email"
    },
    "entity_type": {
      "type": "string",
      "description": "Tipo da entidade relacionada (PurchaseRequest, Report, etc.)"
    },
    "entity_id": {
      "type": "string",
      "description": "ID da entidade relacionada"
    },
    "batch_id": {
      "type": "string",
      "description": "ID do lote (para notifica\u00e7\u00f5es em lote)"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "SCHEDULED",
        "SENDING",
        "SENT",
        "FAILED",
        "CANCELLED"
      ],
      "description": "Status do envio"
    },
    "provider": {
      "type": "string",
      "description": "Provedor utilizado (base44_sendemail, resend, ses, etc.)"
    },
    "error_message": {
      "type": "string",
      "description": "Mensagem de erro, se houver"
    },
    "attempts": {
      "type": "number",
      "default": 0,
      "description": "N\u00famero de tentativas"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do envio"
    },
    "created_by": {
      "type": "string",
      "description": "Email do usu\u00e1rio que solicitou"
    },
    "metadata_json": {
      "type": "object",
      "description": "Metadados adicionais em JSON"
    }
  },
  "required": [
    "notification_type",
    "channel",
    "status"
  ]
}