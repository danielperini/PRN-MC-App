{
  "name": "ApprovalComment",
  "type": "object",
  "properties": {
    "report_id": {
      "type": "string",
      "description": "ID do relat\u00f3rio (FK \u2192 Report)"
    },
    "stage": {
      "type": "string",
      "enum": [
        "SUBMISSION",
        "REVIEW",
        "APPROVAL",
        "REVISION"
      ],
      "description": "Etapa do fluxo quando o coment\u00e1rio foi feito"
    },
    "author_email": {
      "type": "string",
      "description": "Email do autor do coment\u00e1rio"
    },
    "author_name": {
      "type": "string",
      "description": "Nome do autor do coment\u00e1rio"
    },
    "comment": {
      "type": "string",
      "description": "Texto do coment\u00e1rio"
    },
    "section": {
      "type": "string",
      "description": "Se\u00e7\u00e3o do relat\u00f3rio a que se refere (ex: Identifica\u00e7\u00e3o, Atividades, Avalia\u00e7\u00e3o)"
    },
    "resolved": {
      "type": "boolean",
      "default": false,
      "description": "Se o coment\u00e1rio foi resolvido"
    }
  },
  "required": [
    "report_id",
    "stage",
    "author_email",
    "comment"
  ]
}