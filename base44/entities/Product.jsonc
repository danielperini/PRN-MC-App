{
  "name": "Product",
  "type": "object",
  "properties": {
    "activity_id": {
      "type": "string",
      "description": "ID da atividade pai (FK \u2192 Activity)"
    },
    "report_id": {
      "type": "string",
      "description": "ID do relat\u00f3rio mensal vinculado (FK \u2192 Report)"
    },
    "meta_id": {
      "type": "string",
      "description": "ID da meta relacionada (FK \u2192 ProjectMeta, opcional)"
    },
    "rubrica_id": {
      "type": "string",
      "description": "ID da rubrica or\u00e7ament\u00e1ria relacionada (FK \u2192 Rubrica, opcional)"
    },
    "usuario_responsavel_id": {
      "type": "string",
      "description": "Email do usu\u00e1rio respons\u00e1vel (FK \u2192 User)"
    },
    "user_email": {
      "type": "string",
      "description": "Email do autor do produto"
    },
    "nome": {
      "type": "string",
      "description": "Nome do produto"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Cat\u00e1logo",
        "Folder",
        "V\u00eddeo",
        "Cobertura de V\u00eddeo",
        "Cobertura Fotogr\u00e1fica",
        "Texto",
        "Design",
        "Identidade Visual",
        "Logomarca",
        "Release",
        "Post",
        "Relat\u00f3rio",
        "Outro"
      ],
      "description": "Tipo do produto gerado"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do produto"
    },
    "data_inicio": {
      "type": "string",
      "format": "date",
      "description": "Data de in\u00edcio da produ\u00e7\u00e3o"
    },
    "data_fim": {
      "type": "string",
      "format": "date",
      "description": "Data de t\u00e9rmino da produ\u00e7\u00e3o"
    },
    "quantidade": {
      "type": "number",
      "default": 1,
      "description": "Quantidade de itens produzidos"
    },
    "link_arquivo": {
      "type": "string",
      "description": "URL do arquivo ou publica\u00e7\u00e3o (opcional)"
    },
    "fotos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "attachment_id": {
            "type": "string",
            "description": "ID do attachment (FK \u2192 Attachment)"
          }
        }
      },
      "description": "Lista de fotos anexadas"
    },
    "documentos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "attachment_id": {
            "type": "string",
            "description": "ID do attachment (FK \u2192 Attachment)"
          }
        }
      },
      "description": "Lista de documentos anexados"
    }
  },
  "required": [
    "activity_id",
    "report_id",
    "nome",
    "tipo"
  ]
}