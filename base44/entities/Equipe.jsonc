{
  "name": "Equipe",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome da equipe"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da equipe"
    },
    "tipo_funcao": {
      "type": "string",
      "enum": [
        "Administrativa",
        "Coordena\u00e7\u00e3o Geral",
        "Administra\u00e7\u00e3o",
        "Comunica\u00e7\u00e3o",
        "Coordena\u00e7\u00e3o de Comunica\u00e7\u00e3o",
        "Educativo",
        "Produ\u00e7\u00e3o"
      ],
      "description": "Tipo de fun\u00e7\u00e3o da equipe"
    },
    "museu_id": {
      "type": "string",
      "description": "ID do museu vinculado"
    },
    "coordenador_email": {
      "type": "string",
      "description": "Email do coordenador da equipe"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se a equipe est\u00e1 ativa"
    }
  },
  "required": [
    "nome",
    "tipo_funcao"
  ]
}