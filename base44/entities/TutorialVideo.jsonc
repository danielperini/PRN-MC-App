{
  "name": "TutorialVideo",
  "type": "object",
  "properties": {
    "drive_file_id": {
      "type": "string",
      "description": "ID \u00fanico do arquivo no Google Drive"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo do tutorial (derivado do nome do arquivo)"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "URL da thumbnail gerada pelo Drive"
    },
    "embed_url": {
      "type": "string",
      "description": "URL de embed do v\u00eddeo no Drive"
    },
    "drive_created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data de cria\u00e7\u00e3o no Drive"
    },
    "ordem": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o tutorial est\u00e1 ativo na galeria"
    }
  },
  "required": [
    "drive_file_id",
    "titulo"
  ]
}