{
  "name": "DocumentIntake",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio que fez o upload"
    },
    "user_name": {
      "type": "string",
      "description": "Nome do usu\u00e1rio"
    },
    "tipo_detectado": {
      "type": "string",
      "enum": [
        "FOTO_ATIVIDADE",
        "NOTA_FISCAL_PDF",
        "NOTA_FISCAL_XML",
        "DOCUMENTO_ADMINISTRATIVO",
        "CONTRATO",
        "RECIBO_PDF",
        "OUTRO",
        "PENDENTE"
      ],
      "default": "PENDENTE",
      "description": "Tipo detectado pela IA"
    },
    "status_processamento": {
      "type": "string",
      "enum": [
        "ENVIADO",
        "ANALISANDO_IA",
        "AGUARDANDO_REVISAO",
        "RASCUNHO",
        "ENVIADO_APROVACAO",
        "APROVADO",
        "REJEITADO",
        "ERRO_PROCESSAMENTO",
        "DELETADO"
      ],
      "default": "ENVIADO",
      "description": "Estado do processamento da entrada \u00fanica"
    },
    "arquivo_original_url": {
      "type": "string",
      "description": "URL do arquivo original enviado"
    },
    "file_name_original": {
      "type": "string",
      "description": "Nome original do arquivo"
    },
    "file_name_final": {
      "type": "string",
      "description": "Nome final padronizado ap\u00f3s renomea\u00e7\u00e3o"
    },
    "mime_type": {
      "type": "string",
      "description": "MIME type do arquivo"
    },
    "entidade_destino": {
      "type": "string",
      "enum": [
        "PurchaseRequest",
        "TeamPayment",
        "Attachment",
        "Activity",
        "Programacao",
        "TeamMember",
        "Fornecedor",
        ""
      ],
      "description": "Entidade de destino ap\u00f3s roteamento"
    },
    "entidade_destino_id": {
      "type": "string",
      "description": "ID do registro criado na entidade de destino"
    },
    "resultado_ia": {
      "type": "object",
      "description": "Resultado completo da an\u00e1lise da IA (JSON com campos extra\u00eddos)"
    },
    "erros_validacao": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de erros ou inconsist\u00eancias"
    },
    "rubrica_id_sugerida": {
      "type": "string",
      "description": "ID da rubrica sugerida pela IA"
    },
    "rubrica_nome_sugerida": {
      "type": "string",
      "description": "Nome da rubrica sugerida"
    },
    "rubrica_justificativa": {
      "type": "string",
      "description": "Justificativa da sugest\u00e3o de rubrica"
    },
    "rubrica_id": {
      "type": "string",
      "description": "Rubrica confirmada (definitiva). Preenchida automaticamente quando h\u00e1 hist\u00f3rico suficiente do fornecedor, ou manualmente pelo admin."
    },
    "rubrica_nome": {
      "type": "string",
      "description": "Nome da rubrica confirmada (espelho de rubrica_id)"
    },
    "rubrica_confirmada_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da confirma\u00e7\u00e3o autom\u00e1tica da rubrica"
    },
    "rubrica_confirmada_origem": {
      "type": "string",
      "enum": [
        "historico_fornecedor",
        "manual"
      ],
      "description": "Origem da confirma\u00e7\u00e3o da rubrica"
    },
    "centro_custo": {
      "type": "string",
      "description": "Centro de custo identificado ou selecionado"
    },
    "centro_custo_origem": {
      "type": "string",
      "enum": [
        "nome_arquivo",
        "descricao_nota",
        "historico_fornecedor",
        "manual"
      ],
      "description": "Origem da detec\u00e7\u00e3o do centro_custo (motor de decis\u00f5es)"
    },
    "meta_id": {
      "type": "string",
      "description": "ID da meta vinculada automaticamente pelo motor de decis\u00f5es (derivada da rubrica)."
    },
    "activity_id_vinculada": {
      "type": "string",
      "description": "ID da atividade vinculada (para FOTO_ATIVIDADE)"
    },
    "legenda_sugerida": {
      "type": "string",
      "description": "Legenda sugerida pela IA para fotos"
    },
    "revisado_pelo_usuario": {
      "type": "boolean",
      "default": false,
      "description": "Se o usu\u00e1rio j\u00e1 revisou os dados da IA"
    },
    "grupo_upload_id": {
      "type": "string",
      "description": "ID \u00fanico do grupo de upload"
    },
    "grupo_status": {
      "type": "string",
      "enum": [
        "INCOMPLETO",
        "COMPLETO",
        "VINCULADO",
        "ENVIADO_APROVACAO"
      ],
      "default": "INCOMPLETO",
      "description": "Status do agrupamento (PDF+XML)"
    },
    "status_registro": {
      "type": "string",
      "enum": [
        "ATIVO",
        "REMOVIDO"
      ],
      "default": "ATIVO",
      "description": "Status l\u00f3gico do registro"
    },
    "ocultar_entrada_unica": {
      "type": "boolean",
      "default": false,
      "description": "Se deve ser ocultado da fila principal"
    },
    "nf_xml_intake_id": {
      "type": "string"
    },
    "nf_xml_url": {
      "type": "string"
    },
    "nf_pdf_intake_id": {
      "type": "string"
    },
    "nf_pdf_url": {
      "type": "string"
    },
    "nf_emitente_cpf_cnpj": {
      "type": "string"
    },
    "fornecedor_cpf_cnpj": {
      "type": "string"
    },
    "fornecedor_id_vinculado": {
      "type": "string",
      "description": "ID do Fornecedor vinculado no cadastro (FK \u2192 Fornecedor)"
    },
    "municipio": {
      "type": "string"
    },
    "recibo_intake_id": {
      "type": "string"
    },
    "recibo_url": {
      "type": "string"
    },
    "fornecedor_nome": {
      "type": "string"
    },
    "nf_emitente_nome": {
      "type": "string"
    },
    "nf_numero": {
      "type": "string"
    },
    "nf_valor_total": {
      "type": "number"
    },
    "nf_data_emissao": {
      "type": "string",
      "format": "date",
      "description": "Data de emiss\u00e3o da NF (YYYY-MM-DD), preenchida via XML ou IA. Idempotente: n\u00e3o sobrescreve valor j\u00e1 existente."
    },
    "data_abertura_empresa": {
      "type": "string",
      "format": "date",
      "description": "Data de abertura da empresa emitente (YYYY-MM-DD), extra\u00edda via IA do PDF da NF. DIFERENTE da data de emiss\u00e3o da NF \u2014 representa a funda\u00e7\u00e3o do CNPJ."
    },
    "descricao_nota": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada do servi\u00e7o/produto discriminado na NF, extra\u00edda via IA. Usada para identifica\u00e7\u00e3o de museu (MIS/MHAB/MUMO/Noturno 2026/Geral), busca de rubrica e meta."
    },
    "contrato_team_member_id": {
      "type": "string",
      "description": "ID do TeamMember vinculado (para CONTRATO)"
    },
    "contrato_fornecedor_id": {
      "type": "string",
      "description": "ID do Fornecedor vinculado (para CONTRATO)"
    },
    "contrato_numero": {
      "type": "string",
      "description": "N\u00famero do contrato extra\u00eddo pela IA"
    },
    "contrato_drive_url": {
      "type": "string",
      "description": "URL do contrato no Google Drive ap\u00f3s backup"
    },
    "contrato_drive_folder_id": {
      "type": "string",
      "description": "ID da pasta do contrato no Drive"
    },
    "xml_obrigatorio_pendente": {
      "type": "boolean",
      "default": false,
      "description": "True quando NF PDF foi enviada a partir de 01/08/2026 sem XML vinculado"
    },
    "enviado_sem_xml": {
      "type": "boolean",
      "default": false,
      "description": "True quando NF foi enviada para aprova\u00e7\u00e3o sem XML, ap\u00f3s confirma\u00e7\u00e3o do usu\u00e1rio"
    },
    "xml_pendente_desde": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora em que o XML pendente foi detectado"
    }
  },
  "required": [
    "user_email",
    "arquivo_original_url",
    "file_name_original",
    "mime_type"
  ]
}