{
  "name": "ReportPhoto",
  "type": "object",
  "properties": {
    "report_id": {
      "type": "string",
      "description": "ID do relat\u00f3rio (FK \u2192 Report)"
    },
    "attachment_id": {
      "type": "string",
      "description": "ID do anexo/foto original (FK \u2192 Attachment)"
    },
    "activity_id": {
      "type": "string",
      "description": "ID da atividade vinculada"
    },
    "meta_id": {
      "type": "string",
      "description": "ID da meta do projeto \u00e0 qual a foto est\u00e1 vinculada (ex: MC3A-20). Obrigat\u00f3rio para rastreabilidade regulat\u00f3ria (SUCC)."
    },
    "file_url": {
      "type": "string",
      "description": "URL da foto"
    },
    "file_name": {
      "type": "string",
      "description": "Nome do arquivo"
    },
    "caption": {
      "type": "string",
      "description": "Legenda da foto no relat\u00f3rio"
    },
    "legenda": {
      "type": "string",
      "description": "Legenda alternativa"
    },
    "author": {
      "type": "string",
      "description": "Autor da foto"
    },
    "museu": {
      "type": "string",
      "description": "Museu identificado pelo nome do arquivo"
    },
    "mes_referencia": {
      "type": "string",
      "description": "M\u00eas do relat\u00f3rio"
    },
    "ano": {
      "type": "number",
      "description": "Ano do relat\u00f3rio"
    },
    "ordem": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o"
    },
    "foto_principal_atividade": {
      "type": "boolean",
      "default": false,
      "description": "Se true, esta foto \u00e9 a imagem principal/capa da atividade vinculada"
    },
    "galeria_oculta": {
      "type": "boolean",
      "default": false,
      "description": "Se true, a foto est\u00e1 oculta da galeria p\u00fablica mas mantida para auditoria"
    },
    "duplicada_de": {
      "type": "string",
      "description": "ID da ReportPhoto original quando esta \u00e9 identificada como duplicata sem\u00e2ntica ou de arquivo"
    },
    "drive_file_id": {
      "type": "string",
      "description": "ID do arquivo no Google Drive ap\u00f3s backup"
    },
    "drive_backup_status": {
      "type": "string",
      "enum": [
        "pendente",
        "concluido",
        "erro"
      ],
      "default": "pendente",
      "description": "Status do backup no Google Drive"
    },
    "contexto_ia": {
      "type": "string",
      "description": "Contexto gerado pela IA para esta foto (tags, relev\u00e2ncia, descri\u00e7\u00e3o autom\u00e1tica)"
    },
    "fonte_ia": {
      "type": "string",
      "enum": [
        "drive_sync",
        "upload_manual",
        "email_import",
        "ia_curadoria"
      ],
      "description": "Origem da foto no fluxo de importa\u00e7\u00e3o"
    }
  },
  "required": [
    "file_url",
    "file_name"
  ]
}