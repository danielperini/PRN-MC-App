{
  "name": "Comment",
  "type": "object",
  "properties": {
    "report_id": {
      "type": "string",
      "description": "ID do relat\u00f3rio (FK \u2192 Report)"
    },
    "author_email": {
      "type": "string",
      "description": "Email do autor do coment\u00e1rio"
    },
    "author_name": {
      "type": "string",
      "description": "Nome do autor"
    },
    "author_role": {
      "type": "string",
      "enum": [
        "PROFISSIONAL",
        "COORDENADOR",
        "ADMIN"
      ],
      "description": "Papel do autor"
    },
    "conteudo": {
      "type": "string",
      "description": "Texto do coment\u00e1rio"
    },
    "menciona_usuario_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio mencionado (opcional, para @mentions)"
    },
    "eh_resposta_a": {
      "type": "string",
      "description": "ID do coment\u00e1rio pai (se for uma resposta)"
    },
    "resolvido": {
      "type": "boolean",
      "default": false,
      "description": "Se a discuss\u00e3o foi resolvida"
    }
  },
  "required": [
    "report_id",
    "author_email",
    "conteudo"
  ]
}