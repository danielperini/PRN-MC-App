{
  "name": "BackupLog",
  "type": "object",
  "properties": {
    "backup_type": {
      "type": "string",
      "enum": [
        "drive_folders",
        "reports"
      ],
      "description": "Tipo de backup realizado"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failure"
      ],
      "description": "Status da execu\u00e7\u00e3o"
    },
    "total_files": {
      "type": "number",
      "default": 0,
      "description": "Total de arquivos processados"
    },
    "files_copied": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de arquivos copiados com sucesso"
    },
    "backup_folder_id": {
      "type": "string",
      "description": "ID da pasta de backup criada no Drive"
    },
    "error_message": {
      "type": "string",
      "description": "Mensagem de erro se o backup falhou"
    },
    "execution_time_ms": {
      "type": "number",
      "description": "Tempo de execu\u00e7\u00e3o em milissegundos"
    },
    "triggered_by": {
      "type": "string",
      "enum": [
        "manual",
        "scheduled"
      ],
      "default": "manual",
      "description": "Se foi manual ou autom\u00e1tico"
    },
    "shared_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails com os quais o backup foi compartilhado"
    }
  },
  "required": [
    "backup_type",
    "status"
  ]
}