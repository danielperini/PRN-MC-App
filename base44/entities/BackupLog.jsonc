{
  "name": "BackupLog",
  "type": "object",
  "properties": {
    "backup_type": {
      "type": "string",
      "enum": [
        "drive_folders",
        "reports",
        "drive_nf_sync_mensal"
      ],
      "description": "Tipo de backup realizado"
    },
    "entity_type": {
      "type": "string",
      "description": "Tipo de entidade processada (ex: REPORT_DRIVE_SYNC, PHOTO_BACKUP)"
    },
    "entity_id": {
      "type": "string",
      "description": "ID da entidade criada/atualizada"
    },
    "drive_file_id": {
      "type": "string",
      "description": "ID do arquivo no Google Drive \u2014 usado para deduplica\u00e7\u00e3o diferencial"
    },
    "file_name": {
      "type": "string",
      "description": "Nome do arquivo processado"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failure",
        "concluido",
        "erro_ia",
        "sem_autor"
      ],
      "description": "Status da execu\u00e7\u00e3o"
    },
    "processed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do processamento"
    },
    "details": {
      "type": "string",
      "description": "Detalhes do processamento"
    },
    "error_message": {
      "type": "string",
      "description": "Mensagem de erro se falhou"
    },
    "total_files": {
      "type": "number",
      "default": 0,
      "description": "Total de arquivos processados"
    },
    "files_copied": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de arquivos copiados com sucesso"
    },
    "backup_folder_id": {
      "type": "string",
      "description": "ID da pasta de backup criada no Drive"
    },
    "execution_time_ms": {
      "type": "number",
      "description": "Tempo de execu\u00e7\u00e3o em milissegundos"
    },
    "triggered_by": {
      "type": "string",
      "enum": [
        "manual",
        "scheduled"
      ],
      "default": "manual",
      "description": "Se foi manual ou autom\u00e1tico"
    },
    "shared_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails com os quais o backup foi compartilhado"
    }
  },
  "required": [
    "status"
  ]
}