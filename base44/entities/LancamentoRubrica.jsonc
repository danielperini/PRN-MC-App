{
  "name": "LancamentoRubrica",
  "type": "object",
  "properties": {
    "rubrica_id": {
      "type": "string",
      "description": "ID da rubrica relacionada (FK \u2192 Rubrica)"
    },
    "data_lancamento": {
      "type": "string",
      "format": "date",
      "description": "Data do lan\u00e7amento"
    },
    "origem_lancamento": {
      "type": "string",
      "enum": [
        "automatico_compras",
        "manual_usuario"
      ],
      "description": "Origem do lan\u00e7amento"
    },
    "referencia_compra_id": {
      "type": "string",
      "description": "ID da compra relacionada (FK \u2192 PurchaseRequest, se autom\u00e1tico)"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do lan\u00e7amento"
    },
    "fornecedor": {
      "type": "string",
      "description": "Fornecedor (se aplic\u00e1vel)"
    },
    "funcao_origem": {
      "type": "string",
      "description": "Fun\u00e7\u00e3o/categoria de origem"
    },
    "valor": {
      "type": "number",
      "description": "Valor do lan\u00e7amento (pode ser negativo em ajustes)"
    },
    "observacao": {
      "type": "string",
      "description": "Observa\u00e7\u00e3o adicional"
    },
    "justificativa_ajuste": {
      "type": "string",
      "description": "Justificativa obrigat\u00f3ria se valor for negativo"
    },
    "criado_por": {
      "type": "string",
      "description": "Email do usu\u00e1rio que criou"
    }
  },
  "required": [
    "rubrica_id",
    "data_lancamento",
    "origem_lancamento",
    "valor"
  ]
}