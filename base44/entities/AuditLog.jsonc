{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "CREATE",
        "UPDATE",
        "DELETE",
        "SUBMIT",
        "START_REVIEW",
        "APPROVE",
        "RETURN",
        "ARCHIVE",
        "REOPEN"
      ],
      "description": "A\u00e7\u00e3o realizada"
    },
    "entity_type": {
      "type": "string",
      "enum": [
        "REPORT",
        "ACTIVITY",
        "ATTACHMENT",
        "USER"
      ],
      "description": "Tipo de entidade afetada"
    },
    "entity_id": {
      "type": "string",
      "description": "ID da entidade afetada"
    },
    "actor_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio que realizou a a\u00e7\u00e3o"
    },
    "actor_name": {
      "type": "string",
      "description": "Nome do usu\u00e1rio que realizou a a\u00e7\u00e3o"
    },
    "previous_status": {
      "type": "string",
      "description": "Status anterior (mudan\u00e7as de status)"
    },
    "new_status": {
      "type": "string",
      "description": "Novo status (mudan\u00e7as de status)"
    },
    "details": {
      "type": "string",
      "description": "Detalhes adicionais em texto livre"
    }
  },
  "required": [
    "action",
    "entity_type",
    "entity_id",
    "actor_email"
  ]
}