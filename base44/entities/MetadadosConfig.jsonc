{
  "name": "MetadadosConfig",
  "type": "object",
  "properties": {
    "categoria": {
      "type": "string",
      "enum": [
        "museu",
        "tipo_atividade",
        "classificacao",
        "status_relatorio",
        "funcao",
        "equipe"
      ],
      "description": "Categoria do metadado"
    },
    "valor": {
      "type": "string",
      "description": "Valor do metadado (ex: 'MHAB', 'Oficina', 'META')"
    },
    "label": {
      "type": "string",
      "description": "R\u00f3tulo exibido ao usu\u00e1rio"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o opcional do item"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o metadado est\u00e1 ativo para uso no sistema"
    },
    "ordem": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o"
    }
  },
  "required": [
    "categoria",
    "valor",
    "label"
  ]
}