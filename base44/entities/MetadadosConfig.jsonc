{
  "name": "MetadadosConfig",
  "type": "object",
  "properties": {
    "categoria": {
      "type": "string",
      "enum": [
        "museu",
        "tipo_atividade",
        "classificacao",
        "status_relatorio",
        "funcao",
        "equipe",
        "dashboard_criterios"
      ],
      "description": "Categoria do metadado (ou 'dashboard_criterios' para configura\u00e7\u00f5es de crit\u00e9rios de metas f\u00edsicas)"
    },
    "valor": {
      "type": "string",
      "description": "Valor do metadado (ex: 'MHAB', 'Oficina', 'META'); para dashboard_criterios armazena a chave de config"
    },
    "label": {
      "type": "string",
      "description": "R\u00f3tulo exibido ao usu\u00e1rio"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o opcional do item"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o metadado est\u00e1 ativo para uso no sistema"
    },
    "ordem": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o"
    },
    "chave_config": {
      "type": "string",
      "description": "Chave composta para configura\u00e7\u00f5es de crit\u00e9rios de metas f\u00edsicas (ex: 'dashboard_criterios_meta_20', 'dashboard_criterios_noturno')"
    },
    "config_json": {
      "type": "object",
      "description": "Objeto JSON com crit\u00e9rios persistidos: { meta_codigos_aceitos:[], classificacoes_aceitas:[], palavras_chave_inclusao:[], palavras_chave_exclusao:[], geral_mode:'consolidado'|'apenas_geral' }"
    }
  },
  "required": [
    "categoria"
  ]
}