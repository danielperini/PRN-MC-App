{
  "name": "UserRegistration",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Nome completo do solicitante"
    },
    "email": {
      "type": "string",
      "description": "Email do solicitante"
    },
    "funcao": {
      "type": "string",
      "enum": [
        "Educador",
        "Produtor Cultural",
        "Comunicador",
        "Administrador",
        "Outro"
      ],
      "description": "Fun\u00e7\u00e3o do profissional"
    },
    "museu": {
      "type": "string",
      "enum": [
        "MHAB",
        "MIS",
        "MUMO",
        "Atua\u00e7\u00e3o Geral"
      ],
      "description": "Museu de atua\u00e7\u00e3o"
    },
    "equipe": {
      "type": "string",
      "enum": [
        "Comunica\u00e7\u00e3o",
        "Administra\u00e7\u00e3o",
        "Educativo",
        "Produ\u00e7\u00e3o",
        "Outra"
      ],
      "description": "Equipe de atua\u00e7\u00e3o"
    },
    "mensagem": {
      "type": "string",
      "description": "Mensagem/motiva\u00e7\u00e3o do solicitante (opcional)"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDENTE",
        "APROVADO",
        "REJEITADO"
      ],
      "default": "PENDENTE",
      "description": "Status da solicita\u00e7\u00e3o"
    },
    "reviewer_note": {
      "type": "string",
      "description": "Observa\u00e7\u00e3o do coordenador ao aprovar/rejeitar"
    }
  },
  "required": [
    "full_name",
    "email",
    "funcao",
    "museu"
  ]
}