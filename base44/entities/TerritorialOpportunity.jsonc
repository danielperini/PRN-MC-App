{
  "name": "TerritorialOpportunity",
  "type": "object",
  "properties": {
    "museu_sigla": {
      "type": "string",
      "enum": [
        "MHAB",
        "MIS",
        "MUMO",
        "Viaduto das Artes"
      ],
      "description": "Sigla do museu relacionado"
    },
    "nome": {
      "type": "string",
      "description": "Nome da institui\u00e7\u00e3o ou oportunidade"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "Escolas Municipais",
        "Escolas Estaduais",
        "Escolas Secundaristas",
        "EJA",
        "Escolas T\u00e9cnicas",
        "Universidades e Faculdades",
        "Centros Culturais",
        "Bibliotecas",
        "Lares de Idosos e Centros de Conviv\u00eancia",
        "Associa\u00e7\u00f5es e Coletivos",
        "Grupos de Fotografia",
        "Grupos de Cinema e Audiovisual",
        "Grupos de Moda",
        "Grupos de Patrim\u00f4nio, Mem\u00f3ria e Museologia",
        "Oportunidades de Forma\u00e7\u00e3o e Mobiliza\u00e7\u00e3o"
      ],
      "description": "Categoria da institui\u00e7\u00e3o"
    },
    "bairro": {
      "type": "string",
      "description": "Bairro ou regi\u00e3o de localiza\u00e7\u00e3o"
    },
    "distancia_estimada": {
      "type": "number",
      "description": "Dist\u00e2ncia estimada em km do museu"
    },
    "publicos_alvo": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Infantil",
          "Juvenil",
          "Secundaristas",
          "Universit\u00e1rios",
          "Professores",
          "Idosos",
          "Turistas",
          "Profissionais da Cultura",
          "Designers",
          "Fot\u00f3grafos",
          "Cineastas",
          "Educadores",
          "Pesquisadores",
          "Coletivos Comunit\u00e1rios",
          "Artistas Locais"
        ]
      },
      "description": "P\u00fablicos-alvo identificados"
    },
    "temas_relacionados": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Temas principais associados (ex: moda, patrim\u00f4nio, cinema)"
    },
    "nivel_aderencia": {
      "type": "number",
      "default": 0,
      "description": "Score 0-100 de ader\u00eancia \u00e0s atividades do museu"
    },
    "prioridade": {
      "type": "string",
      "enum": [
        "Alta",
        "M\u00e9dia",
        "Baixa"
      ],
      "default": "M\u00e9dia",
      "description": "Prioridade para parceria/mobiliza\u00e7\u00e3o"
    },
    "potencial_parceria": {
      "type": "string",
      "description": "Tipo de parceria potencial (ex: visitas escolares, oficinas, eventos)"
    },
    "observacoes_curadoria": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es da IA sobre oportunidade"
    },
    "justificativa_ia": {
      "type": "string",
      "description": "Justificativa t\u00e9cnica gerada pela IA"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se a oportunidade est\u00e1 ativa no mapa"
    },
    "data_curadoria": {
      "type": "string",
      "format": "date-time",
      "description": "Data da \u00faltima curadoria/an\u00e1lise pela IA"
    }
  },
  "required": [
    "museu_sigla",
    "nome",
    "categoria"
  ]
}