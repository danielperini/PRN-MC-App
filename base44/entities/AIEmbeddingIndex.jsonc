{
  "name": "AIEmbeddingIndex",
  "type": "object",
  "properties": {
    "tipo_indice": {
      "type": "string",
      "enum": [
        "releases",
        "relatorios",
        "programacao",
        "agenda",
        "imagens",
        "documentos"
      ],
      "description": "Tipo de \u00edndice"
    },
    "data_ultima_sincronizacao": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltima vez que \u00edndice foi atualizado"
    },
    "quantidade_registros": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de registros indexados"
    },
    "quantidade_embeddings": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de embeddings gerados"
    },
    "status": {
      "type": "string",
      "enum": [
        "nao_iniciado",
        "sincronizando",
        "sincronizado",
        "erro"
      ],
      "default": "nao_iniciado",
      "description": "Status da sincroniza\u00e7\u00e3o"
    },
    "mensagem_status": {
      "type": "string",
      "description": "Mensagem descritiva do status"
    },
    "proxima_sincronizacao_agendada": {
      "type": "string",
      "format": "date-time",
      "description": "Pr\u00f3xima sincroniza\u00e7\u00e3o agendada"
    },
    "configuracao": {
      "type": "object",
      "description": "Configura\u00e7\u00e3o espec\u00edfica do \u00edndice",
      "properties": {
        "atualizar_novos": {
          "type": "boolean",
          "default": true
        },
        "atualizar_existentes": {
          "type": "boolean",
          "default": false
        },
        "incluir_arquivados": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "ativo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "tipo_indice"
  ],
  "rls": {}
}