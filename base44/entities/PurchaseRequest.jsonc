{
  "name": "PurchaseRequest",
  "type": "object",
  "properties": {
    "numero_processamento": {
      "type": "string",
      "description": "N\u00famero \u00fanico de processamento no formato MMDDYYYYXXXX"
    },
    "report_id": {
      "type": "string"
    },
    "activity_id": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "meta_id": {
      "type": "string",
      "enum": [
        "MC3A-20",
        "MC3A-21",
        "MC3A-22",
        "MC3A-23",
        "MC3A-24",
        "MC3A-25",
        "MC3A-EXTRA"
      ]
    },
    "meta_extra_descricao": {
      "type": "string"
    },
    "budgetline_id": {
      "type": "string"
    },
    "rubrica_id": {
      "type": "string"
    },
    "rubrica_mes_inicial": {
      "type": "number",
      "description": "M\u00eas inicial de execu\u00e7\u00e3o conforme o Plano de Trabalho oficial (ex: 19)"
    },
    "rubrica_mes_final": {
      "type": "number",
      "description": "M\u00eas final de execu\u00e7\u00e3o conforme o Plano de Trabalho oficial (ex: 28)"
    },
    "natureza_despesa": {
      "type": "string",
      "description": "Natureza da despesa (339030|339035|339037|339039) \u2014 espelhada da rubrica vinculada"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "Servi\u00e7os (equipe/coordena\u00e7\u00e3o)",
        "Servi\u00e7os (comunica\u00e7\u00e3o: designer, foto, v\u00eddeo, imprensa, redes)",
        "Servi\u00e7os (produ\u00e7\u00e3o/infraestrutura/expografia)",
        "Servi\u00e7os (eventos/atra\u00e7\u00f5es/artistas)",
        "Servi\u00e7os (seguran\u00e7a/limpeza)",
        "Log\u00edstica (transporte/vans)",
        "Alimenta\u00e7\u00e3o (lanche/caf\u00e9/coffeebreak)",
        "Consultoria / Forma\u00e7\u00e3o / Acessibilidade",
        "Materiais de consumo",
        "Outros"
      ]
    },
    "tipo_gasto": {
      "type": "string",
      "enum": [
        "Produto",
        "Servi\u00e7o"
      ]
    },
    "centro_custo": {
      "type": "string",
      "enum": [
        "MUMO",
        "MIS",
        "MHAB",
        "Noturno nos Museus 2026",
        "Noturno 2026",
        "Noturno Pampulha",
        "Publica\u00e7\u00f5es",
        "Geral"
      ]
    },
    "descricao_item": {
      "type": "string"
    },
    "qtd": {
      "type": "number",
      "default": 1
    },
    "unidade": {
      "type": "string"
    },
    "valor_solicitado": {
      "type": "number"
    },
    "fornecedor_nome": {
      "type": "string"
    },
    "fornecedor_cnpj": {
      "type": "string"
    },
    "fornecedor_contato": {
      "type": "string"
    },
    "link_proposta": {
      "type": "string"
    },
    "meio_pagamento": {
      "type": "string",
      "enum": [
        "PIX",
        "TED/Transfer\u00eancia",
        "Boleto",
        "Cart\u00e3o",
        "Dinheiro"
      ]
    },
    "detalhe_pagamento": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "RASCUNHO",
        "SOLICITADO",
        "APROVADO_COORD",
        "APROVADO_ADMIN",
        "RECUSADO",
        "CANCELADO",
        "DEVOLVIDO",
        "PAGO"
      ],
      "default": "RASCUNHO"
    },
    "pago": {
      "type": "boolean",
      "default": false
    },
    "status_pagamento": {
      "type": "string",
      "enum": [
        "pendente",
        "pago",
        "aguardando_comprovante",
        "revisao_manual"
      ],
      "default": "pendente"
    },
    "comprovante_pagamento_url": {
      "type": "string"
    },
    "data_pagamento": {
      "type": "string",
      "format": "date-time"
    },
    "usuario_pagamento": {
      "type": "string"
    },
    "usuario_pagamento_nome": {
      "type": "string"
    },
    "confianca_vinculo_pagamento": {
      "type": "number"
    },
    "vinculo_automatico_ia": {
      "type": "boolean",
      "default": false
    },
    "aprov_coord_nome": {
      "type": "string"
    },
    "aprov_coord_data": {
      "type": "string",
      "format": "date"
    },
    "aprov_coord_comentario": {
      "type": "string"
    },
    "aprov_admin_nome": {
      "type": "string"
    },
    "aprov_admin_data": {
      "type": "string",
      "format": "date"
    },
    "aprov_admin_comentario": {
      "type": "string"
    },
    "valor_aprovado_admin": {
      "type": "number"
    },
    "valor_pago": {
      "type": "number"
    },
    "data_pagamento_efetivo": {
      "type": "string",
      "format": "date"
    },
    "comprovante_url": {
      "type": "string"
    },
    "nota_fiscal_url": {
      "type": "string"
    },
    "orcamento_url": {
      "type": "string"
    },
    "observacoes": {
      "type": "string"
    },
    "ai_meta_score": {
      "type": "number"
    },
    "ai_meta_sugerida": {
      "type": "string"
    },
    "ai_analise": {
      "type": "string"
    },
    "quitada": {
      "type": "boolean",
      "default": false
    },
    "nf_numero": {
      "type": "string"
    },
    "nf_emitente_nome": {
      "type": "string"
    },
    "nf_valor_total": {
      "type": "number"
    },
    "nf_data_emissao": {
      "type": "string",
      "format": "date"
    },
    "nf_chave_acesso": {
      "type": "string",
      "description": "Chave de acesso NF-e (44 d\u00edgitos) do XML"
    },
    "valor_total": {
      "type": "number"
    },
    "valor_aprovado": {
      "type": "number"
    },
    "comentario_aprovacao": {
      "type": "string"
    },
    "comentario_desaprovacao": {
      "type": "string"
    },
    "comentario_devolucao": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "rejected_by": {
      "type": "string"
    },
    "rejected_at": {
      "type": "string",
      "format": "date-time"
    },
    "comentario_rejeicao": {
      "type": "string"
    },
    "rubrica_debitada_em": {
      "type": "string"
    },
    "rubrica_debitada_valor": {
      "type": "number"
    },
    "financeiro_lancado_em": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "arquivo_url": {
      "type": "string"
    },
    "arquivo_nome": {
      "type": "string"
    },
    "arquivo_tipo": {
      "type": "string"
    },
    "nf_pdf_url": {
      "type": "string"
    },
    "documento_url": {
      "type": "string"
    },
    "nf_emitente_cpf_cnpj": {
      "type": "string"
    },
    "origem": {
      "type": "string"
    },
    "tipo_origem": {
      "type": "string"
    },
    "intake_id": {
      "type": "string"
    },
    "documento_intake_id": {
      "type": "string"
    },
    "entidade_destino_id": {
      "type": "string"
    },
    "attachment_id": {
      "type": "string"
    },
    "rubrica_nome": {
      "type": "string"
    },
    "natureza_despesa_purchase": {
      "type": "string",
      "description": "Natureza da despesa espelhada da rubrica vinculada \u00e0 solicita\u00e7\u00e3o"
    },
    "team_payment_id": {
      "type": "string"
    },
    "drive_backup_status": {
      "type": "string",
      "enum": [
        "pendente",
        "em_processamento",
        "concluido",
        "erro",
        "sem_arquivos"
      ]
    },
    "drive_backup_folder_id": {
      "type": "string"
    },
    "drive_backup_folder_url": {
      "type": "string"
    },
    "drive_backup_files": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "drive_backup_at": {
      "type": "string",
      "format": "date-time"
    },
    "drive_backup_error": {
      "type": "string"
    },
    "duplicidade_status": {
      "type": "string",
      "enum": [
        "nenhuma",
        "suspeita",
        "confirmada",
        "arquivada",
        "revisada"
      ],
      "default": "nenhuma",
      "description": "Status de auditoria de duplicidade desta nota fiscal"
    },
    "duplicidade_nota_original_id": {
      "type": "string",
      "description": "ID da PurchaseRequest original, quando esta for identificada como duplicata"
    },
    "duplicidade_motivo": {
      "type": "string"
    },
    "duplicidade_revisado_por": {
      "type": "string"
    },
    "duplicidade_revisado_em": {
      "type": "string",
      "format": "date-time"
    },
    "duplicidade_bloqueada": {
      "type": "boolean",
      "default": false,
      "description": "Se true, aprova\u00e7\u00e3o foi bloqueada por duplicidade detectada"
    },
    "duplicada_financeira": {
      "type": "boolean",
      "default": false,
      "description": "Se true, esta NF \u00e9 duplicata financeira e n\u00e3o entra no somat\u00f3rio"
    },
    "duplicata_de": {
      "type": "string"
    },
    "incluir_no_somatorio": {
      "type": "boolean",
      "default": true,
      "description": "Se false, esta NF \u00e9 exclu\u00edda do somat\u00f3rio financeiro"
    },
    "cod": {
      "type": "string",
      "description": "C\u00f3digo oficial de 2 d\u00edgitos da coluna N4 do Plano de Trabalho (ex: 42, 53, 22)"
    },
    "status_cod": {
      "type": "string",
      "enum": [
        "OK",
        "REVISAR",
        "SEM_RUBRICA",
        "SEM_CODIGO"
      ],
      "description": "Status da valida\u00e7\u00e3o do campo cod"
    },
    "codigo_pdf_ok": {
      "type": "string",
      "enum": [
        "SIM",
        "N\u00c3O",
        "N\u00c3O_SE_APLICA"
      ]
    },
    "codigo_xml_ok": {
      "type": "string",
      "enum": [
        "SIM",
        "N\u00c3O",
        "N\u00c3O_SE_APLICA"
      ]
    },
    "backup_validado": {
      "type": "string",
      "enum": [
        "SIM",
        "N\u00c3O"
      ]
    },
    "motivo_revisao": {
      "type": "string"
    }
  },
  "required": [
    "descricao_item",
    "valor_solicitado"
  ]
}