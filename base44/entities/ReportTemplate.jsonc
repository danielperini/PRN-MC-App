{
  "name": "ReportTemplate",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome do template"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do template"
    },
    "author_email": {
      "type": "string",
      "description": "Email do autor que criou o template"
    },
    "author_name": {
      "type": "string",
      "description": "Nome do autor do template"
    },
    "museu": {
      "type": "string",
      "description": "Museu padr\u00e3o do template"
    },
    "equipe": {
      "type": "string",
      "description": "Equipe padr\u00e3o do template"
    },
    "template_data": {
      "type": "object",
      "description": "Dados salvos do template (estrutura do relat\u00f3rio)"
    },
    "secoes_incluidas": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "identificacao",
          "atividades",
          "oportunidades",
          "avaliacao"
        ]
      },
      "description": "Se\u00e7\u00f5es inclu\u00eddas neste template"
    },
    "eh_publico": {
      "type": "boolean",
      "default": false,
      "description": "Se o template \u00e9 compartilhado publicamente"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags para busca e categoriza\u00e7\u00e3o"
    },
    "usos_count": {
      "type": "number",
      "default": 0,
      "description": "N\u00famero de vezes que o template foi usado"
    }
  },
  "required": [
    "nome",
    "author_email",
    "template_data"
  ]
}