{
  "name": "syncBaseConhecimento",
  "entry": "entry.ts",
  "automations": [
    {
      "type": "scheduled",
      "name": "sync_programacao_horaria",
      "description": "Atualiza automaticamente a programação dos Museus Centro a cada hora, incluindo alterações dos meses atual e seguinte.",
      "function_args": {
        "mode": "hourly_programacao_sync",
        "force_programacao_sync": true
      },
      "is_active": true,
      "schedule_mode": "recurring",
      "schedule_type": "cron",
      "cron_expression": "7 * * * *"
    }
  ]
}
