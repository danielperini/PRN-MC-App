{
  "name": "Restaurar NFs Banco\u2192Backup XML \u2014 05h00",
  "description": "Restaura links de PRs (com CNPJ+nf_numero) a partir dos XMLs da pasta de backup do Drive. Custo zero (sem OpenAI). Roda diariamente ap\u00f3s a sincroniza\u00e7\u00e3o principal (04h00).",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "restaurar_nfs_banco_backup_xml_05h00",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "restaurarNFsBancoBackup",
            "args": {
              "dryRun": false,
              "limite": 250
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "restaurarNFsBancoBackup"
  }
}