{
  "name": "Sync Semanal \u2014 Relat\u00f3rios e Galeria para o Drive",
  "description": "Sincroniza automaticamente fotos da galeria e PDFs de relat\u00f3rios aprovados para o Google Drive, organizados por museu e m\u00eas.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 3 * * 0",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sync_semanal_relat_rios_e_galeria_para_o_drive",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncRelatoriosGaleriaDrive",
            "args": {
              "modo": "ambos",
              "limite": 100
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "syncRelatoriosGaleriaDrive"
