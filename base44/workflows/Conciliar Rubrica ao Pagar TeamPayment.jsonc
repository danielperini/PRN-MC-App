{
  "name": "Conciliar Rubrica ao Pagar TeamPayment",
  "description": "Recalcula valor_utilizado e saldo da rubrica quando um TeamPayment tem o status alterado para APROVADO_ADMIN ou PAGO",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"APROVADO_ADMIN\" or .trigger.data.status == \"PAGO\" or .trigger.data.status == \"CANCELADO\" or .trigger.data.status == \"RECUSADO\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "TeamPayment"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "conciliar_rubrica_ao_pagar_teampayment",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "updateBudgetOnApproval",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "updateBudgetOnApproval"
  }
}