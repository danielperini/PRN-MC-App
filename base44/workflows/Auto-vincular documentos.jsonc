{
  "name": "Auto-vincular documentos",
  "description": "",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"resultado_ia\") != null) and (.trigger.data.status_processamento == \"AGUARDANDO_REVISAO\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "DocumentIntake"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_vincular_documentos",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "vincularDocumentosAutomatico",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "vincularDocumentosAutomatico"
  }
}