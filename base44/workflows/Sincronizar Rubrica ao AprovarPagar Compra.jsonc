{
  "name": "Sincronizar Rubrica ao Aprovar/Pagar Compra",
  "description": "Orquestrador \u00fanico de d\u00e9bito/estorno de rubrica com valida\u00e7\u00e3o IA. Ao aprovar/pagar: valida rubrica via IA, corrige se divergir com score >= 70, debita e recalcula saldo. Ao cancelar/recusar/devolver ou remover NF: estorna o d\u00e9bito. Idempotente.",
  "trigger": {
    "condition": "${ (.trigger.data.status == \"APROVADO_ADMIN\" or .trigger.data.status == \"PAGO\" or .trigger.data.status == \"APROVADO_COORD\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "PurchaseRequest"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sincronizar_rubrica_ao_aprovar_pagar_compra",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncRubricaOnPurchaseStatusChange",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "syncRubricaOnPurchaseStatusChange"
  }
}