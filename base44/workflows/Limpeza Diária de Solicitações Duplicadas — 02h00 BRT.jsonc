{
  "name": "Limpeza Di\u00e1ria de Solicita\u00e7\u00f5es Duplicadas \u2014 02h00 BRT",
  "description": "Limpeza autom\u00e1tica di\u00e1ria da lista de solicita\u00e7\u00f5es (PurchaseRequest): agrupa por nf_numero id\u00eantico e remove duplicatas quando pelo menos 2 de 3 campos (CNPJ, valor, data de emiss\u00e3o) coincidem. Mant\u00e9m a solicita\u00e7\u00e3o com melhor status (PAGO > APROVADO > SOLICITADO). Deduplica tamb\u00e9m attachments com mesmo purchase_id. Executa como service-role (rede de seguran\u00e7a noturna).",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 5 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "limpeza_di_ria_de_solicita_es_duplicadas_02h00_brt",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "removerSolicitacoesDuplicadas",
            "args": {
              "triggered_by": "scheduled"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "removerSolicitacoesDuplicadas"
  }
}