{
  "name": "Backup Autom\u00e1tico NFs no Drive \u2014 Aprova\u00e7\u00e3o/Pagamento",
  "description": "Quando uma solicita\u00e7\u00e3o de compra \u00e9 aprovada (APROVADO_ADMIN) ou paga (PAGO), dispara backup autom\u00e1tico de todos os arquivos anexados para pasta estruturada no Google Drive.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"APROVADO_ADMIN\" or .trigger.data.status == \"PAGO\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "PurchaseRequest"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "backup_autom_tico_nfs_no_drive_aprova_o_pagamento",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "driveBackupPurchase",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "driveBackupPurchase"
  }
}