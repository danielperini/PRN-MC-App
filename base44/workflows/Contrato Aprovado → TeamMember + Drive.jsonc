{
  "name": "Contrato Aprovado \u2192 TeamMember + Drive",
  "description": "Quando um DocumentIntake do tipo CONTRATO \u00e9 aprovado na Entrada de Documentos, cria/atualiza automaticamente o TeamMember com ficha completa e faz backup no Drive.",
  "trigger": {
    "condition": "${ ((.trigger.data.tipo_detectado == \"CONTRATO\") and (.trigger.data.status_processamento == \"APROVADO\") and (.trigger.changed_fields | index(\"status_processamento\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "DocumentIntake"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "contrato_aprovado_teammember_drive",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onContratoAprovadoEntradaUnica",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onContratoAprovadoEntradaUnica"
  }
}