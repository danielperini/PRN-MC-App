{
  "name": "Publicar fotos na galeria ao aprovar relat\u00f3rio",
  "description": "Ao aprovar um relat\u00f3rio, envia as fotos em evid\u00eancia para a galeria, faz backup no Drive e vincula \u00e0s atividades.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"APPROVED\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Report"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "publicar_fotos_na_galeria_ao_aprovar_relat_rio",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "publicarFotosRelatorioAprovado",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "publicarFotosRelatorioAprovado"
  }
}