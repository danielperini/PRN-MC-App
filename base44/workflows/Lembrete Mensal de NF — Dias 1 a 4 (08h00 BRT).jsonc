      "name": "lembrete_mensal_de_nf_dias_1_a_4_08h00_brt",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyMonthlyInvoiceReminder",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
