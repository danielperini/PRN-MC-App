{
  "name": "Backup Relatorio Aprovado Drive",
  "description": "Backup autom\u00e1tico de relat\u00f3rios aprovados no Google Drive",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"APROVADO\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Report"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "backup_relatorio_aprovado_drive",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "backupRelatoriosDrive",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "backupRelatoriosDrive"
  }
}