{
  "name": "Vincular Metas \u00e0s Fotos do Drive \u2014 Mensal dia 1",
  "description": "Cruza fotos importadas do Drive com as metas cadastradas via an\u00e1lise sem\u00e2ntica de nome de arquivo, legenda, museu e per\u00edodo. Preenche automaticamente o campo meta_id para comprova\u00e7\u00e3o SUCC.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 3 1 * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "vincular_metas_s_fotos_do_drive_mensal_dia_1",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "vincularMetasReportPhotos",
            "args": {
              "limite": 500,
              "apenas_sem_meta": true
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "vincularMetasReportPhotos"
  }
}