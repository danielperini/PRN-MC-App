{
  "name": "Recalcular Rubricas ao Alterar Solicita\u00e7\u00e3o",
  "description": "Recalcula automaticamente os saldos de todas as rubricas sempre que uma solicita\u00e7\u00e3o de compra relevante \u00e9 criada, atualizada ou deletada.",
  "trigger": {
    "condition": "${ (.trigger.data.status == \"APROVADO\" or .trigger.data.status == \"APROVADO_COORD\" or .trigger.data.status == \"APROVADO_ADMIN\" or .trigger.data.status == \"PAGO\" or .trigger.data.status == \"RECUSADO\" or .trigger.data.status == \"CANCELADO\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update",
        "delete"
      ],
      "entity_name": "PurchaseRequest"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "recalcular_rubricas_ao_alterar_solicita_o",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "recalcularSaldosRubricas",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "recalcularSaldosRubricas"
  }
}