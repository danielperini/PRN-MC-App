{
  "name": "Backup NFs Sem Backup \u2014 a cada 4h",
  "description": "Rodada complementar a cada 4 horas que processa a fila de NFs aprovadas marcadas como 'Sem backup' (drive_backup_status != 'concluido') fazendo o backup organizado no Google Drive em Notas Fiscais/{ANO}/{MES}, renomeando conforme padr\u00e3o oficial, e marcando drive_backup_status='concluido'. Complementa a automa\u00e7\u00e3o di\u00e1ria 02h00 para limpar backlog mais r\u00e1pido.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 4,
      "interval_unit": "hours",
      "interval_anchor": "2026-08-06T16:21:05.906000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "backup_nfs_sem_backup_a_cada_4h",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "backupDiarioNFsDrive",
            "args": {
              "limite": 50
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "backupDiarioNFsDrive"
  }
}