{
  "name": "Notificar TeamMember ativo ao ser criado \u2014 Completar Cadastro",
  "description": "Quando um TeamMember \u00e9 criado com status ATIVO e n\u00e3o \u00e9 observador, envia e-mail de boas-vindas pedindo para completar cadastro e enviar contrato",
  "trigger": {
    "condition": "${ (.trigger.data.status == \"ATIVO\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "TeamMember"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notificar_teammember_ativo_ao_ser_criado_completar_cadastro",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyTeamCompletarCadastro",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyTeamCompletarCadastro"
  }
}