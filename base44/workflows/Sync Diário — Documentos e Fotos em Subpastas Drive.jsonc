{
  "name": "Sync Di\u00e1rio \u2014 Documentos e Fotos em Subpastas Drive",
  "description": "Varre recursivamente todas as subpastas do Google Drive buscando novos documentos e fotos n\u00e3o processados (NFs, contratos, fotos de atividades), mantendo o banco sempre atualizado. Executa diariamente \u00e0s 06h30 (Bras\u00edlia), junto ao ciclo de sincroniza\u00e7\u00e3o di\u00e1ria.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "30 12 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sync_di_rio_documentos_e_fotos_em_subpastas_drive",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sincronizarDocumentosDrive",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sincronizarDocumentosDrive"
  }
}