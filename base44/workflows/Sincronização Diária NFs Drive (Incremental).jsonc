{
  "name": "Sincroniza\u00e7\u00e3o Di\u00e1ria NFs Drive (Incremental)",
  "description": "Sincroniza\u00e7\u00e3o di\u00e1ria autom\u00e1tica da pasta raiz de NFs (notasfiscais-App): copia arquivos novos/modificados nas \u00faltimas 25h para pasta de backup com nome padronizado e processa XMLs (cria PR + aprova auto) e PDFs (intake revis\u00e3o). Registra em BackupLog com tipo drive_nf_sync_mensal.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 5 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sincroniza_o_di_ria_nfs_drive_incremental",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "normalizarPastasDriveNFs",
            "args": {
              "mode": "incremental",
              "cron": true
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "normalizarPastasDriveNFs"
  }
}