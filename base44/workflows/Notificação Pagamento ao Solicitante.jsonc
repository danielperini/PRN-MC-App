{
  "name": "Notifica\u00e7\u00e3o Pagamento ao Solicitante",
  "description": "Dispara e-mail imediato ao solicitante quando o status da compra muda para PAGO.",
  "trigger": {
    "condition": "${ (.trigger.data.status == \"PAGO\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "PurchaseRequest"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notifica_o_pagamento_ao_solicitante",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyPagamentoSolicitante",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyPagamentoSolicitante"
  }
}