{
  "name": "Notificar Solicitante \u2014 Pagamento Confirmado (PAGO)",
  "description": "Quando uma PurchaseRequest muda para status PAGO, dispara e-mail imediato ao solicitante original confirmando o pagamento.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"PAGO\") and (.trigger.old_data.status != \"PAGO\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "PurchaseRequest"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notificar_solicitante_pagamento_confirmado_pago",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyPagamentoSolicitante",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyPagamentoSolicitante"
  }
}